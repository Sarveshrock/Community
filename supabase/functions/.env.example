# Supabase Edge Function secrets. Set with:
#   supabase secrets set --env-file supabase/functions/.env
# NEVER commit a filled-in .env, and NEVER ship these values inside the Flutter app.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider abstraction (spec section 78) — optional, functions fall back
# to deterministic (non-AI) scoring/parsing without it. AI_PROVIDER selects
# the implementation in supabase/functions/_shared/aiProvider.ts — "gemini"
# (Google AI Studio: https://aistudio.google.com/apikey) or "anthropic"
# (https://console.anthropic.com) both work; add another class there for a
# different vendor and switch this to swap.
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=
AI_MODEL=gemini-flash-latest

# Tech intelligence pipeline (get-news function, supabase/functions/get-news/)
# — Hacker News, arXiv, tech RSS feeds, and Show HN need no key at all.
# These three are optional; each source degrades gracefully without its key
# (lower rate limit, or that one source skipped entirely — never a crash):
#
# Raises GitHub's search API rate limit (60/hr unauthenticated is usually
# fine for a 30-60min schedule, but a token avoids ever hitting it). Create
# a fine-grained PAT with no extra scopes at https://github.com/settings/tokens.
GITHUB_TOKEN=
# Raises Semantic Scholar's rate limit. Request one at
# https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=
# X/Twitter is opt-in only — get-news works normally with every other
# source if this is unset. Needs an X API v2 Bearer token (paid tier) from
# https://developer.x.com if you want it.
X_BEARER_TOKEN=

# Shared secret guarding server-only invocations: send-notification (called
# by other functions/webhooks with the service role, never a client) and
# the pg_cron job that refreshes news on a schedule (see
# supabase/migrations/0025_tech_intelligence_pipeline.sql). After setting
# this, also run once (not part of any migration, so it's never in git):
#   select vault.create_secret('<this value>', 'service_function_secret');
SERVICE_FUNCTION_SECRET=change-me

# Push notification delivery (spec section 47) — optional, send-notification
# skips push (in-app notifications still write) without it. Legacy FCM HTTP
# server key from Firebase Console -> Project Settings -> Cloud Messaging;
# covers Android and iOS once the app registers a device token.
FCM_SERVER_KEY=
