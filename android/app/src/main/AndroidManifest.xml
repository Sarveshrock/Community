<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Local discovery (spec section 33) needs only an approximate fix —
         intentionally not requesting ACCESS_FINE_LOCATION, so Android's own
         permission dialog offers "approximate location" rather than exact. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Required on Android 13+ to show notifications at all — requested at
         runtime via FirebaseMessaging.requestPermission() (see
         PushNotificationService), this declaration just makes that request
         legal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="community_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- image_cropper (profile photo upload, see EditProfileScreen):
             the crop UI itself is this native uCrop activity — required by
             the plugin regardless of which screen invokes it. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar"/>
        <!-- Customizable App Icon (Settings > Appearance > App Icon): each
             style below is a real, separate launcher entry point aliased
             back to MainActivity — Android has no API to swap one launcher
             icon's image at runtime, only to enable/disable which of
             several declared components is the active one. Exactly one of
             {MainActivity, these 7 aliases} is ever enabled at a time;
             AppIconMethodHandler.kt is what flips them. Starts disabled —
             MainActivity (Classic) is the default active entry point. -->
        <activity-alias
            android:name=".AppIconDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dark"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AppIconMinimal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_minimal"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AppIconNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_neon"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AppIconGradient"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gradient"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AppIconGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_glass"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AppIconDeveloper"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_developer"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AppIconGaming"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gaming"
            android:label="community_app"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <!-- Default channel/icon FCM falls back to for a background/
             terminated-app notification it posts itself, before
             PushNotificationService has ever run in this install to create
             the same channel via flutter_local_notifications. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="communeo_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
